# Crispy Fortnight - Environment Variables
# Copy this file to .env and fill in your values

# Database
POSTGRES_USER=crispy
POSTGRES_PASSWORD=crispy_dev_password
POSTGRES_MULTIPLE_DATABASES=fs04_pm,fs02_collab

# Redis
REDIS_PASSWORD=crispy_redis_password

# JWT (CHANGE IN PRODUCTION - use 32+ char random strings)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars

# Stripe (FS-04 billing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# FS-04 Specific
FS04_PORT=4001
FS04_CORS_ORIGIN=http://localhost:3001

# FS-02 Specific
FS02_PORT=4002
FS02_WS_PORT=4003
FS02_CORS_ORIGIN=http://localhost:3002

# Frontend
FS04_FRONTEND_PORT=3001
FS02_FRONTEND_PORT=3002

# Production overrides (docker-compose.prod.yml uses these)
# NODE_ENV=production
# POSTGRES_PASSWORD=production_secure_password
# REDIS_PASSWORD=production_redis_password
# JWT_SECRET=production_32_char_minimum_secret